{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/stochastic-models",
      "has": [{ "type": "query", "key": "lesson", "value": "(?<lesson>[a-z0-9-]+)" }],
      "destination": "/stochastic-models/:lesson",
      "permanent": true
    },
    {
      "source": "/guide",
      "has": [{ "type": "query", "key": "topic", "value": "(?<topic>[a-z0-9-]+)" }],
      "destination": "/guide/:topic",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(llms|llms-full)\\.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
